# Runtime PNGs stay in ordinary Git: they are small enough, required on every
# checkout, and LFS would not reduce the exported game. LFS is reserved for
# heavyweight editable masters placed under asset_sources/ in the future.
asset_sources/**/*.psd filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.psb filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.kra filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.blend filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.xcf filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.wav filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.mov filter=lfs diff=lfs merge=lfs -text
asset_sources/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
